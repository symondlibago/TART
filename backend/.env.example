APP_NAME="Event Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# "Today" is decided in this timezone, not in the database's UTC.
# Attendance and event statuses both depend on it.
APP_BUSINESS_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# DATABASE - Supabase Postgres
# Dashboard -> Connect -> Session pooler (IPv4, port 5432)
# ----------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require

# Reuse the connection between requests: saves ~600-900ms of TCP+TLS each.
# Only valid on the session pooler (5432), not the transaction pooler (6543).
DB_PERSISTENT=true

# Send each query as one statement instead of PREPARE + EXECUTE.
# ~3x faster per query over a high latency link.
DB_EMULATE_PREPARES=true

# ----------------------------------------------------------------------
# CORS - which frontend origins may call this API.
# Comma separated, no trailing slash. Leave empty locally (falls back to *).
# ALWAYS set this in production.
# ----------------------------------------------------------------------
FRONTEND_URL=

# ----------------------------------------------------------------------
# SUPABASE STORAGE - attendance photos
# Storage -> New bucket -> name "attendance", mark it Public.
# Settings -> API -> service_role key.
# Leave SUPABASE_URL empty to write to storage/app/public instead (local only;
# those files do not survive a redeploy).
# ----------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=attendance

# Set to true on the first deploy and after any schema change.
RUN_MIGRATIONS=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
